# Fuzzing dictionary for pugixml XML processing library
# Combined from pugixml and libxml2 dictionaries
# Optimized for lean, high-impact XML fuzzing

# XML Declaration and basic structure
xml_decl="<?xml version='1.0'?>"
xml_decl_standalone="<?xml version='1.0' standalone='1'?>"
xml_decl_encoding="<?xml version='1.0' encoding='UTF-8'?>"

# Element tags
tag_open="<a>"
tag_close="</a>"
tag_open_close="<a />"
tag_cdata="<![CDATA["
tag_ignore="<![IGNORE["
tag_include="<![INCLUDE["
tag_doctype="<!DOCTYPE"
tag_attlist="<!ATTLIST"
tag_element="<!ELEMENT"
tag_entity="<!ENTITY"
tag_notation="<!NOTATION"
tag_open_exclamation="<!"
tag_open_q="<?"
tag_xml_q="<?xml?>"
tag_sq2_close="]]>"

# Attributes
attr_encoding=" encoding=\"1\""
attr_standalone=" standalone=\"no\""
attr_version=" version=\"1\""
attr_xml_base=" xml:base=\"1\""
attr_xml_id=" xml:id=\"1\""
attr_xml_lang=" xml:lang=\"1\""
attr_xml_space=" xml:space=\"1\""
attr_xmlns=" xmlns=\"1\""
attr_href=" href=\"1\""
attr_generic=" a=\"1\""

# Namespaces
ns_decl=" xmlns:a='a'"
ns_default=" xmlns='a'"
ns_prefix="a:"
string_xmlns="xmlns:"

# Entities
entity_builtin="&lt;"
entity_decimal="&#1;"
entity_hex="&#x1;"
entity_external="&a;"
ge_ref_lt="&lt;"
ge_ref_gt="&gt;"
ge_ref_amp="&amp;"
ge_ref_apos="&apos;"
ge_ref_quot="&quot;"
char_ref_dec="&#60;"
char_ref_hex="&#x3c;"

# XML Schema/DTD strings
string_any="ANY"
string_cdata="CDATA"
string_empty="EMPTY"
string_entities="ENTITIES"
string_entity="ENTITY"
string_fixed="#FIXED"
string_id="ID"
string_idref="IDREF"
string_idrefs="IDREFS"
string_implied="#IMPLIED"
string_nmtoken="NMTOKEN"
string_nmtokens="NMTOKENS"
string_notation="NOTATION"
string_pcdata="#PCDATA"
string_public="PUBLIC"
string_required="#REQUIRED"
string_system="SYSTEM"
string_utf8="UTF-8"
string_utf16="UTF-16"
string_ucs4="UCS-4"

# Character sets
cs_utf8="UTF-8"
cs_utf16="UTF-16"
cs_utf16le="UTF-16LE"
cs_utf16be="UTF-16BE"
cs_latin1="ISO-8859-1"
cs_ascii="ASCII"

# XPath functions
xpath_boolean="boolean"
xpath_count="count"
xpath_contains="contains"
xpath_concat="concat"
xpath_ceiling="ceiling"
xpath_false="false"
xpath_floor="floor"
xpath_id="id"
xpath_last="last"
xpath_lang="lang"
xpath_local_name="local-name"
xpath_name="name"
xpath_namespace_uri="namespace-uri"
xpath_normalize_space="normalize-space"
xpath_not="not"
xpath_number="number"
xpath_position="position"
xpath_round="round"
xpath_string="string"
xpath_string_length="string-length"
xpath_starts_with="starts-with"
xpath_substring_before="substring-before"
xpath_substring_after="substring-after"
xpath_substring="substring"
xpath_sum="sum"
xpath_translate="translate"
xpath_true="true"

# XPath axes
axis_ancestor="ancestor"
axis_ancestor_or_self="ancestor-or-self"
axis_attribute="attribute"
axis_child="child"
axis_descendant="descendant"
axis_descendant_or_self="descendant-or-self"
axis_following="following"
axis_following_sibling="following-sibling"
axis_namespace="namespace"
axis_parent="parent"
axis_preceding="preceding"
axis_preceding_sibling="preceding-sibling"
axis_self="self"

# XPath node tests
node_comment="comment"
node_node="node"
node_processing_instruction="processing-instruction"
node_text="text"

# XPath operators and syntax
op_or="or"
op_and="and"
op_div="div"
op_mod="mod"
op_gt=">"
op_gte=">="
op_lt="<"
op_lte="<="
op_not="!"
op_ne="!="
op_eq="="
op_plus="+"
op_minus="-"
op_mult="*"
op_union="|"
variable="$"
paren_open="("
paren_close=")"
bracket_open="["
bracket_close="]"
comma=","
double_slash="//"
slash="/"
parent=".."
dot="."
at="@"
double_colon="::"
colon=":"

# Common patterns
string_empty_dblquotes="\"\""
string_empty_quotes="''"
string_brackets="[]"
string_parentheses="()"
string_dashes="--"
string_percent="%a"
string_col_fallback=":fallback"
string_col_generic=":a"
string_col_include=":include"
string_schema=":schema"

# Complete XML constructs for boundary testing
cdata_section="<![CDATA[ ]]>"
comment="<!-- -->"
pi="<?a?>"
doctype_simple="<!DOCTYPE a []>"
elem_start_end="<a></a>"
elem_empty="<a/>"
elem_ns_start_end="<a:a xmlns:a='a'></a:a>"
elem_ns_empty="<a:a xmlns:a='a'/>"
