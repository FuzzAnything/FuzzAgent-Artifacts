# Protobuf fuzzing dictionary
# Lean, high-impact dictionary for protobuf fuzzing
# AFL/LibFuzzer format: name="value" or name="\x00\x01"

# Field types
field_type_int32="int32"
field_type_sint32="sint32"
field_type_sfixed32="sfixed32"
field_type_int64="int64"
field_type_sint64="sint64"
field_type_sfixed64="sfixed64"
field_type_uint32="uint32"
field_type_fixed32="fixed32"
field_type_uint64="uint64"
field_type_fixed64="fixed64"
field_type_float="float"
field_type_double="double"
field_type_bool="bool"
field_type_string="string"
field_type_bytes="bytes"

# Keywords
keyword_required="required"
keyword_optional="optional"
keyword_repeated="repeated"
keyword_message="message"
keyword_enum="enum"
keyword_package="package"
keyword_import="import"
keyword_service="service"
keyword_rpc="rpc"
keyword_returns="returns"
keyword_oneof="oneof"
keyword_extensions="extensions"
keyword_reserved="reserved"
keyword_default="default"
keyword_packed="packed"
keyword_deprecated="deprecated"
keyword_allow_alias="allow_alias"

# Wire types
wire_type_VARINT="VARINT"
wire_type_FIXED64="FIXED64"
wire_type_LENGTH_DELIMITED="LENGTH_DELIMITED"
wire_type_START_GROUP="START_GROUP"
wire_type_END_GROUP="END_GROUP"
wire_type_FIXED32="FIXED32"

# Important numeric values
number_zero="0"
number_one="1"
number_varint_boundary_127="127"
number_varint_boundary_128="128"
number_varint_boundary_16383="16383"
number_varint_boundary_16384="16384"
number_varint_boundary_2097151="2097151"
number_varint_boundary_2097152="2097152"
number_varint_boundary_268435455="268435455"
number_varint_boundary_268435456="268435456"
number_neg_one="-1"
number_neg_123456="-123456"
number_test_value_42="42"
number_test_value_666="666"
number_test_value_1000="1000"
number_test_value_1001="1001"

# Field numbers that test boundaries
field_num_15="15"
field_num_16="16"
field_num_2047="2047"
field_num_2048="2048"
field_num_262143="262143"
field_num_262144="262144"
field_num_33554431="33554431"
field_num_33554432="33554432"

# String encodings
encoding_UTF8="UTF-8"
encoding_UTF16="UTF-16"
encoding_UTF16BE="UTF-16BE"
encoding_UTF16LE="UTF-16LE"
encoding_USASCII="US-ASCII"
encoding_ISO88591="ISO-8859-1"

# Special string values (without problematic characters)
str_hello_world="hello world"
str_hi_mom="hi mom"
str_http="http://"
str_https="https://"

# Important message types
message_TestMess="TestMess"
message_SubMess="SubMess"
message_TestMessPacked="TestMessPacked"
message_TestMessOptional="TestMessOptional"
message_TestMessOneof="TestMessOneof"
message_TestMessRequiredInt32="TestMessRequiredInt32"

# Enum values
enum_NEG_VALUE="NEG_VALUE"
enum_VALUE="VALUE"
enum_OTHER_VALUE="OTHER_VALUE"
enum_VALUENEG123456="VALUENEG123456"
enum_VALUE0="VALUE0"
enum_VALUE1="VALUE1"
enum_VALUE127="VALUE127"
enum_VALUE128="VALUE128"
enum_VALUE16383="VALUE16383"
enum_VALUE16384="VALUE16384"
enum_VALUE_A="VALUE_A"
enum_VALUE_B="VALUE_B"
enum_VALUE_C="VALUE_C"
enum_VALUE_D="VALUE_D"

# Common field names
field_name_test="test"
field_name_value="value"
field_name_id="id"
field_name_name="name"
field_name_data="data"
field_name_payload="payload"
field_name_content="content"
field_name_field="field"
field_name_item="item"
field_name_entry="entry"
field_name_key="key"
field_name_val="val"
field_name_num="num"
field_name_count="count"

# Special hex values for protobuf wire format
hex_wire_varint="\x08"
hex_wire_fixed64="\x09"
hex_wire_length_delimited="\x0A"
hex_wire_fixed32="\x0D"
hex_varint_1="\x01"
hex_varint_127="\x7F"
hex_varint_128="\x80\x01"
hex_field_1="\x08"
hex_field_2="\x10"
hex_field_15="\x78"
hex_field_16="\x80\x01"
