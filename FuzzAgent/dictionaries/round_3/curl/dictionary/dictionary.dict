# Curl Fuzzing Dictionary
# Common HTTP methods
method_get="GET"
method_post="POST"
method_put="PUT"
method_delete="DELETE"
method_head="HEAD"
method_options="OPTIONS"
method_connect="CONNECT"
method_patch="PATCH"
method_trace="TRACE"

# HTTP versions
http10="HTTP/1.0"
http11="HTTP/1.1"
http2="HTTP/2"
http3="HTTP/3"

# HTTP status codes
status_100="100"
status_200="200"
status_301="301"
status_400="400"
status_404="404"
status_500="500"
status_501="501"
status_502="502"

# Common HTTP headers
header_host="Host:"
header_content_type="Content-Type:"
header_content_length="Content-Length:"
header_content_encoding="Content-Encoding:"
header_transfer_encoding="Transfer-Encoding:"
header_connection="Connection:"
header_date="Date:"
header_server="Server:"
header_user_agent="User-Agent:"
header_accept="Accept:"
header_accept_encoding="Accept-Encoding:"
header_authorization="Authorization:"
header_cookie="Cookie:"
header_set_cookie="Set-Cookie:"
header_referer="Referer:"
header_location="Location:"
header_last_modified="Last-Modified:"
header_cache_control="Cache-Control:"
header_expires="Expires:"
header_pragma="Pragma:"
header_accept_ranges="Accept-Ranges:"
header_range="Range:"

# Content types
content_type_text_html="text/html"
content_type_text_plain="text/plain"
content_type_application_json="application/json"
content_type_application_xml="application/xml"
content_type_application_form="application/x-www-form-urlencoded"
content_type_multipart_form="multipart/form-data"
content_type_application_octet="application/octet-stream"

# Charsets
charset_utf8="charset=UTF-8"
charset_iso88591="charset=ISO-8859-1"

# Transfer encodings
encoding_chunked="chunked"
encoding_gzip="gzip"
encoding_deflate="deflate"
encoding_compress="compress"
encoding_br="br"
encoding_identity="identity"
encoding_bzip2="bzip2"
encoding_lzma="lzma"
encoding_xz="xz"

# Connection options
connection_close="close"
connection_keep_alive="keep-alive"

# Cache control directives
cache_no_cache="no-cache"
cache_no_store="no-store"
cache_must_revalidate="must-revalidate"

# Date format example
date_example="Fri, 31 Dec 1999 23:59:59 GMT"

# Protocol schemes
scheme_http="http://"
scheme_https="https://"
scheme_ftp="ftp://"
scheme_sftp="sftp://"
scheme_file="file://"
scheme_ldap="ldap://"
scheme_mailto="mailto:"
scheme_rtsp="rtsp://"
scheme_rtmp="rtmp://"

# URL components
url_path_root="/"
url_path_index="/index.html"
url_path_api="/api/v1"
url_query_start="?"
url_query_sep="&"
url_query_eq="="
url_fragment="#"

# Authentication
auth_basic="Basic"
auth_bearer="Bearer"
auth_digest="Digest"
auth_ntlm="NTLM"

# Curl-specific options (from curl_fuzzer.h TLV types)
curl_opt_url="CURLOPT_URL"
curl_opt_userpwd="CURLOPT_USERPWD"
curl_opt_postfields="CURLOPT_POSTFIELDS"
curl_opt_header="CURLOPT_HEADER"
curl_opt_cookie="CURLOPT_COOKIE"
curl_opt_range="CURLOPT_RANGE"
curl_opt_customrequest="CURLOPT_CUSTOMREQUEST"
curl_opt_httpheader="CURLOPT_HTTPHEADER"
curl_opt_useragent="CURLOPT_USERAGENT"
curl_opt_referer="CURLOPT_REFERER"
curl_opt_followlocation="CURLOPT_FOLLOWLOCATION"
curl_opt_maxredirs="CURLOPT_MAXREDIRS"
curl_opt_timeout="CURLOPT_TIMEOUT"
curl_opt_connecttimeout="CURLOPT_CONNECTTIMEOUT"
curl_opt_ssl_verifypeer="CURLOPT_SSL_VERIFYPEER"
curl_opt_ssl_verifyhost="CURLOPT_SSL_VERIFYHOST"
curl_opt_proxy="CURLOPT_PROXY"
curl_opt_proxyuserpwd="CURLOPT_PROXYUSERPWD"
curl_opt_verbose="CURLOPT_VERBOSE"
curl_opt_nobody="CURLOPT_NOBODY"

# HTTP authentication methods
curl_auth_basic="CURLAUTH_BASIC"
curl_auth_digest="CURLAUTH_DIGEST"
curl_auth_ntlm="CURLAUTH_NTLM"
curl_auth_negotiate="CURLAUTH_NEGOTIATE"
curl_auth_any="CURLAUTH_ANY"

# Special characters and delimiters
