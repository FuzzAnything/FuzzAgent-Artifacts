ext_htm=".htm"
ext_txt=".txt"
ext_json=".json"
ext_xml=".xml"
ext_pdf=".pdf"
ext_jpg=".jpg"
ext_png=".png"
ext_gif=".gif"
ext_zip=".zip"
ext_tar=".tar"
ext_gz=".gz"

# Common MIME boundary
mime_boundary="---------------------------boundary"

# Empty values
empty_object="{}"
empty_array="[]"
null_value="null"
true_value="true"
false_value="false"

# Number formats
number_zero="0"
number_one="1"
number_ten="10"
number_hundred="100"
number_thousand="1000"
number_max_int="2147483647"
number_max_long="9223372036854775807"

# Special URL patterns
