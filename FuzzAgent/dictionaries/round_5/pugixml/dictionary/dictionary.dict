# Lean, high-impact fuzzing dictionary for pugixml XML parsing library
# Combined from pugixml and libxml2 dictionaries
# Optimized for XML parsing operations

# XML Declaration and Basic Structure
xml_decl="<?xml version='1.0'?>"
xml_decl_standalone="<?xml version='1.0' standalone='1'?>"
xml_decl_latin1="<?xml version='1.0' encoding='ISO-8859-1'?>"
tag_xml_q="<?xml?>"

# Element Tags and Structure
tag_open="<a>"
tag_close="</a>"
tag_open_close="<a />"
tag_open_exclamation="<!"
tag_open_q="<?"
tag_sq2_close="]]>"
elem_start_end="<a></a>"
elem_empty="<a/>"
elem_ns_start_end="<a:a xmlns:a='a'></a:a>"
elem_ns_empty="<a:a xmlns:a='a'/>"

# Attributes
attr=" a='a'"
attr_encoding=" encoding=\"1\""
attr_generic=" a=\"1\""
attr_href=" href=\"1\""
attr_standalone=" standalone=\"no\""
attr_version=" version=\"1\""
attr_xml_base=" xml:base=\"1\""
attr_xml_id=" xml:id=\"1\""
attr_xml_lang=" xml:lang=\"1\""
attr_xml_space=" xml:space=\"1\""
attr_xmlns=" xmlns=\"1\""
ns_decl=" xmlns:a='a'"
ns_default=" xmlns='a'"
ns_prefix="a:"
string_xmlns="xmlns:"

# CDATA Sections
tag_cdata="<![CDATA["
cdata_section="<![CDATA[ ]]>"

# Comments
comment="<!-- -->"

# Processing Instructions
pi="<?a?>"

# Document Type Definitions
tag_doctype="<!DOCTYPE"
tag_attlist="<!ATTLIST"
tag_element="<!ELEMENT"
tag_entity="<!ENTITY"
tag_notation="<!NOTATION"
tag_include="<![INCLUDE["
tag_ignore="<![IGNORE["
doctype="<!DOCTYPE a []>"
doctype_system="<!DOCTYPE a SYSTEM 'a' []>"
doctype_public="<!DOCTYPE a PUBLIC 'a' 'a' []>"

# Element Declarations
elem_decl_any="<!ELEMENT a ANY>"
elem_decl_empty="<!ELEMENT a EMPTY>"
elem_decl_children="<!ELEMENT a (a)>"
elem_decl_mixed="<!ELEMENT a (#PCDATA|a)>"
string_pcdata="#PCDATA"
string_empty="EMPTY"
string_any="ANY"

# Element Children and Quantifiers
elem_children_choice="|a"
elem_children_seq=",a"
elem_children_sub_choice="|(a)"
elem_children_sub_seq=",(a)"
elem_quant_any="*"
elem_quant_opt="?"
elem_quant_some="+"
string_brackets="[]"
string_parentheses="()"

# Attribute Declarations
string_cdata="CDATA"
string_id="ID"
string_idref="IDREF"
string_idrefs="IDREFS"
string_entity="ENTITY"
string_entities="ENTITIES"
string_nmtoken="NMTOKEN"
string_nmtokens="NMTOKENS"
string_notation="NOTATION"
string_fixed="#FIXED"
string_implied="#IMPLIED"
string_required="#REQUIRED"
string_public="PUBLIC"
string_system="SYSTEM"

# Entities
entity_builtin="&lt;"
entity_decimal="&#1;"
entity_external="&a;"
entity_hex="&#x1;"
ge_ref_lt="&lt;"
ge_ref_gt="&gt;"
ge_ref_amp="&amp;"
ge_ref_apos="&apos;"
ge_ref_quot="&quot;"
ge_ref="&a;"
ge_ref_quoted="&#38;a;"
pe_ref="%a;"
pe_ref_quoted="&#37;a;"
char_ref_dec="&#60;"
char_ref_hex="&#x3c;"
char_ref_quoted="&#38;#60;"
string_percent="%a"

# Include and Ignore Sections
include_sect="<![INCLUDE[ ]]>"
ignore_sect="<![IGNORE[ ]]>"
string_dashes="--"
string_col_fallback=":fallback"
string_col_generic=":a"
string_col_include=":include"
string_schema=":schema"

# Character Sets
string_ucs4="UCS-4"
string_utf16="UTF-16"
string_utf8="UTF-8"
cs_utf8="UTF-8"
cs_utf16="UTF-16"
cs_utf16le="UTF-16LE"
cs_utf16be="UTF-16BE"
cs_ucs2="UCS-2"
cs_ucs4="UCS-4"
cs_latin1="ISO-8859-1"
cs_ascii="ASCII"
cs_ebcdic="EBCDIC"
cs_iso2022jp="ISO-2022-JP"
cs_shift_jis="SHIFT_JIS"
cs_euc_jp="EUC-JP"

# XPath Axes
axis_ancestor="ancestor::"
axis_ancestor_or_self="ancestor-or-self::"
axis_attribute="attribute::"
axis_attribute_abbrev="@"
axis_child="child::"
axis_descendant="descendant::"
axis_descendant_or_self="descendant-or-self::"
axis_following="following::"
axis_following_sibling="following-sibling::"
axis_namespace="namespace::"
axis_parent="parent::"
axis_preceding="preceding::"
axis_preceding_siblings="preceding-sibling::"
axis_self="self::"

# XPath Node Tests
node_test_ns="a:"
step_root="/"
step_descendant="//"
step_any="//*"
step_any_l="*//"
step_elem="//b"
step_ns_elem="//a:a"
step_comment="//comment()"
step_node="//node()"
step_node_l="node()//"
step_pi="//processing-instruction()"
step_text="//text()"
step_parent="../"

# XPath Functions
xpath_boolean="boolean"
xpath_count="count"
xpath_contains="contains"
xpath_concat="concat"
xpath_ceiling="ceiling"
xpath_false="false"
xpath_floor="floor"
xpath_id="id"
xpath_last="last"
xpath_lang="lang"
xpath_local_name="local-name"
xpath_name="name"
xpath_namespace_uri="namespace-uri"
xpath_normalize_space="normalize-space"
xpath_not="not"
xpath_number="number"
xpath_position="position"
xpath_round="round"
xpath_string="string"
xpath_string_length="string-length"
xpath_starts_with="starts-with"
xpath_substring_before="substring-before"
xpath_substring_after="substring-after"
xpath_substring="substring"
xpath_sum="sum"
xpath_translate="translate"
xpath_true="true"

# XPath Operators
op_plus="+1"
op_minus=" - 1"
op_neg="-"
op_mul="*1"
op_div=" div 1"
op_mod=" mod 1"
op_and=" and 1"
op_or=" or 1"
op_ne="!=1"
op_lt="<1"
op_gt=">1"
op_le="<=1"
op_ge=">=1"
op_predicate_num="[1]"
op_predicate_last="[last()]"
op_predicate_str="['a']"
op_predicate="[1=1]"
op_arg_num=",1"
op_arg_str=",'a'"
op_arg_node=",*"
op_union="|//b"

# XPath Values and Variables
val_num="=(1.0)"
val_str_sq="=('a')"
val_str_dq="=(\"a\")"
val_node_set="=(*)"
val_elem="=(b)"
var_num="=$f"
var_bool="=$b"
var_str="=$s"
var_node_set="=$n"

# XPath Syntax Elements
xpath_or="or"
xpath_and="and"
xpath_div="div"
xpath_mod="mod"
xpath_gt=">"
xpath_ge=">="
xpath_lt="<"
xpath_le="<="
xpath_not_sym="!"
xpath_ne="!="
xpath_eq="="
xpath_plus="+"
xpath_minus="-"
xpath_star="*"
xpath_pipe="|"
xpath_dollar="$"
xpath_lparen="("
xpath_rparen=")"
xpath_lbracket="["
xpath_rbracket="]"
xpath_comma=","
xpath_double_slash="//"
xpath_slash="/"
xpath_dot_dot=".."
xpath_dot="."
xpath_at="@"
xpath_double_colon="::"
xpath_colon=":"

# Unicode and Special Characters
utf8_2="\xC3\x84"
utf8_3="\xE2\x80\x9C"
utf8_4="\xF0\x9F\x98\x80"
string_empty_dblquotes="\"\""
string_empty_quotes="''"

# XPath Node Types
xpath_comment="comment"
xpath_node="node"
xpath_processing_instruction="processing-instruction"
xpath_text="text"
