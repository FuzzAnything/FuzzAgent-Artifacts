# GLTF/GLB format tokens for tinygltf fuzzing
# Extracted from assimp fuzzer dictionary and enhanced with tinygltf-specific keywords

# Core glTF JSON structure keywords
"asset"
"scene"
"scenes"
"nodes"
"meshes"
"accessors"
"bufferViews"
"buffers"
"materials"
"textures"
"images"
"animations"
"skins"
"samplers"
"cameras"
"extensions"
"extras"

# Buffer and data
"uri"
"byteLength"
"byteOffset"
"byteStride"
"bufferView"
"componentType"
"count"
"type"

# Mesh and geometry
"attributes"
"indices"
"mode"
"position"
"normal"
"texcoord"
"tangent"
"color"
"weights"
"joints"
"primitive"
"primitives"

# Material properties
"pbrMetallicRoughness"
"baseColorFactor"
"metallicFactor"
"roughnessFactor"
"normalTexture"
"occlusionTexture"
"emissiveTexture"
"alphaMode"
"alphaCutoff"
"doubleSided"

# Node transformations
"matrix"
"rotation"
"scale"
"translation"
"children"

# Animation
"channels"
"samplers"
"input"
"output"
"interpolation"
"target"
"path"

# Camera
"perspective"
"orthographic"
"yfov"
"znear"
"zfar"
"xmag"
"ymag"
"aspectRatio"

# glTF binary format markers (GLB)
"glTF"
"JSON"
"BIN"
"version"
"generator"
"minVersion"
"copyright"

# Common JSON structure
"{"
"}"
"["
"]"
":"
","
"true"
"false"
"null"
"\"\""
"0"
"1"
"-1"
"0.0"
"1.0"
"0.5"
