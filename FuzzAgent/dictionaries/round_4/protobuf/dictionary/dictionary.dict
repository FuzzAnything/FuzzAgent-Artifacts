# Protobuf fuzzing dictionary
# Protocol Buffer syntax and keywords
syntax="proto3"
package="protobuf_unittest"
message="TestAllTypes"
enum="NestedEnum"
import="unittest_import_proto3.proto"
option="csharp_namespace"
option="java_outer_classname"
repeated="int32"
required="string"
optional="bytes"
map="string,int32"
service="TestService"
rpc="TestMethod"
returns="Response"
stream="Request"
# Field types
int32="1"
int64="2"
uint32="3"
uint64="4"
sint32="5"
sint64="6"
fixed32="7"
fixed64="8"
sfixed32="9"
sfixed64="10"
float="11"
double="12"
bool="true"
string="test"
bytes="\x01\x02\x03"
# Enum values
UNSPECIFIED="0"
FOO="1"
BAR="2"
BAZ="3"
NEG="-1"
# Special values
true="true"
false="false"
# Field numbers
field_number_1="1"
field_number_2="2"
field_number_3="3"
# Message delimiters
message_start="\x0a"
message_end="\x10"
# Wire types
wire_varint="0"
wire_fixed64="1"
wire_length_delimited="2"
wire_start_group="3"
wire_end_group="4"
wire_fixed32="5"
# Common patterns
single_field="\x08\x01"
repeated_field="\x0a\x02\x08\x01"
nested_message="\x1a\x02\x08\x01"
enum_field="\x20\x01"
