#
# Combined fuzzing dictionary for libtiff (TIFF image library)
# Generated from OSS-Fuzz sources with protocol matching
#

# TIFF-specific tokens from AFL dictionary
header_ii="II*\x00"
header_mm="MM\x00*"

# TIFF IFD entry tags (common/standard tags)
section_100="\x00\x01"
section_101="\x01\x01"
section_102="\x02\x01"
section_103="\x03\x01"
section_106="\x06\x01"
section_107="\x07\x01"
section_10D="\x0d\x01"
section_10E="\x0e\x01"
section_10F="\x0f\x01"
section_110="\x10\x01"
section_111="\x11\x01"
section_112="\x12\x01"
section_115="\x15\x01"
section_116="\x16\x01"
section_117="\x17\x01"
section_11A="\x1a\x01"
section_11B="\x1b\x01"
section_11C="\x1c\x01"
section_11D="\x1d\x01"
section_11E="\x1e\x01"
section_11F="\x1f\x01"
section_122="\"\x01"
section_123="#\x01"
section_124="$\x01"
section_125="%\x01"
section_128="(\x01"
section_129=")\x01"
section_12D="-\x01"
section_131="1\x01"
section_132="2\x01"
section_13B=";\x01"
section_13C="<\x01"
section_13D="=\x01"
section_13E=">\x01"
section_13F="?\x01"
section_140="@\x01"
section_FE="\xfe\x00"
section_FF="\xff\x00"

# Common image compression methods for TIFF
comp_none="\x01\x00"
comp_ccitt="\x02\x00"
comp_fax3="\x03\x00"
comp_fax4="\x04\x00"
comp_lzw="\x05\x00"
comp_ojpeg="\x06\x00"
comp_jpeg="\x07\x00"
comp_deflate="\x08\x00"
comp_packbits="\x0b\x00"

# Photometric interpretation values
photo_miniswhite="\x00\x00"
photo_minisblack="\x01\x00"
photo_rgb="\x02\x00"
photo_palette="\x03\x00"
photo_mask="\x04\x00"
photo_separated="\x05\x00"
photo_ycbcr="\x06\x00"
photo_cielab="\x08\x00"
photo_icclab="\x09\x00"
photo_itulab="\x0a\x00"

# Planar configuration
planar_config="\x0c\x01"
planar_chunky="\x01\x00"
planar_planar="\x02\x00"

# Orientation values
orientation="\x11\x01"
orient_top_left="\x01\x00"
orient_top_right="\x02\x00"
orient_bottom_right="\x03\x00"
orient_bottom_left="\x04\x00"
orient_left_top="\x05\x00"
orient_right_top="\x06\x00"
orient_right_bottom="\x07\x00"
orient_left_bottom="\x08\x00"

# Sample format values
sample_format="\x53\x01"
sample_uint="\x01\x00"
sample_int="\x02\x00"
sample_float="\x03\x00"
sample_void="\x04\x00"

# TIFF-specific string markers
tiff_version="\x2a\x00"
bigtiff_version="\x2b\x00"

# Common byte order markers
little_endian="\x49\x49"
big_endian="\x4d\x4d"

# Common IFD structure markers
ifd_offset="\x08\x00\x00\x00"
ifd_terminator="\x00\x00\x00\x00"

# Cross-format image markers (may appear in TIFF containers)
jpeg_marker_sof0="\xff\xc0"
jpeg_marker_sof2="\xff\xc2"
jpeg_marker_dht="\xff\xc4"
jpeg_marker_sos="\xff\xda"
jpeg_marker_eoi="\xff\xd9"
jpeg_marker_dqt="\xff\xdb"
jpeg_marker_dri="\xff\xdd"
jpeg_marker_app0="\xff\xe0"
jpeg_marker_app1="\xff\xe1"

# PNG-like chunk names (for embedded PNG in TIFF)
png_chunk_ihdr="IHDR"
png_chunk_idat="IDAT"
png_chunk_iend="IEND"
png_chunk_plte="PLTE"

# General image color space markers
colorspace_srgb="sRGB"
colorspace_icc="iCCP"

# Common TIFF vendor tags
tiff_software="\x31\x01"
tiff_make="\x0f\x01"
tiff_model="\x10\x01"
tiff_artist="\x13\x01"
tiff_copyright="\x82\x98"
