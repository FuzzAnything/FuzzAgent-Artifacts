# GIF format markers
header_87a="87a"
header_89a="89a"
header_gif="GIF"
marker_2c=","
marker_3b=";"
section_2101="!\x01\x12"
section_21f9="!\xf9\x04"
section_21fe="!\xfe"
section_21ff="!\xff\x11"

# OpenCV-specific tokens
# Color spaces and image formats
cv_bgr="BGR"
cv_rgb="RGB"
cv_gray="GRAY"
cv_bgra="BGRA"
cv_rgba="RGBA"
cv_hsv="HSV"
cv_yuv="YUV"
cv_lab="LAB"

# Common matrix types
cv_8uc1="CV_8UC1"
cv_8uc3="CV_8UC3"
cv_8uc4="CV_8UC4"
cv_32fc1="CV_32FC1"
cv_32fc3="CV_32FC3"

# Image read/write flags
imread_unchanged="IMREAD_UNCHANGED"
imread_grayscale="IMREAD_GRAYSCALE"
imread_color="IMREAD_COLOR"
imread_anydepth="IMREAD_ANYDEPTH"
imread_anycolor="IMREAD_ANYCOLOR"

# FileStorage markers (OpenCV XML/YAML serialization)
fs_opencv_storage="opencv_storage"
fs_opencv_ml="opencv_ml"
fs_matrix="matrix"
fs_rows="rows"
fs_cols="cols"
fs_dt="dt"
fs_data="data"

# Common OpenCV function names (for API fuzzing)
cv_imdecode="imdecode"
cv_imencode="imencode"
cv_imread="imread"
cv_imwrite="imwrite"
cv_cvtcolor="cvtColor"
cv_resize="resize"
cv_gaussianblur="GaussianBlur"
cv_canny="Canny"
cv_threshold="threshold"

# Neural network related (for readNetFromTensorFlow)
tf_pbtxt=".pbtxt"
tf_pb=".pb"
tf_graphdef="graph_def"
tf_node="node"
tf_op="op"
tf_input="input"
tf_output="output"

# Common image processing kernels
kernel_3x3="\x00\x00\x00\x00\x01\x00\x00\x00\x00"
kernel_sobel_x="\xff\x00\x01\xfe\x00\x02\xff\x00\x01"
kernel_sobel_y="\xff\xfe\xff\x00\x00\x00\x01\x02\x01"

# BMP header (simple)
bmp_header="BM"

# WebP simple marker
webp_header="RIFF"
webp_webp="WEBP"

# JPEG2000 markers
jp2_header="\x00\x00\x00\x0cjP  \x0d\x0a\x87\x0a"
