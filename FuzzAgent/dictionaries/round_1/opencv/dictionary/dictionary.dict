#
# Fuzzing dictionary for OpenCV (Computer Vision Library)
# -------------------------------------------------------
#
# Combined from standard image format dictionaries and OpenCV-specific tokens
#

# PNG format markers
header_png="\x89PNG\x0d\x0a\x1a\x0a"
section_IDAT="IDAT"
section_IEND="IEND"
section_IHDR="IHDR"
section_PLTE="PLTE"
section_bKGD="bKGD"
section_cHRM="cHRM"
section_gAMA="gAMA"
section_hIST="hIST"
section_iCCP="iCCP"
section_iTXt="iTXt"
section_pHYs="pHYs"
section_sBIT="sBIT"
section_sRGB="sRGB"
section_tEXt="tEXt"
section_tIME="tIME"
section_tRNS="tRNS"
section_zTXt="zTXt"

# JPEG format markers  
header_jfif="JFIF\x00"
header_jfxx="JFXX\x00"
