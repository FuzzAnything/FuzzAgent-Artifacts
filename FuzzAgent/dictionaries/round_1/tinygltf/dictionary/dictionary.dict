# JSON syntax tokens
token_brace="{"
token_brace_close="}"
token_bracket="["
token_bracket_close="]"
token_comma=","
token_colon=":"
token_quote="\""
token_null="null"
token_true="true"
token_false="false"
token_empty_string="\"\""
token_empty_object="{}"
token_empty_array="[]"
token_number_zero="0"
token_number_one="1"
token_number_float="1.234"
token_number_scientific="3e4"
token_number_scientific_neg="-1.2e+3"
token_infinity="Infinity"
token_neg_infinity="-Infinity"
token_nan="NaN"

# JSON escape sequences
escape_backslash="\\"
escape_backspace="\\b"
escape_formfeed="\\f"
escape_newline="\\n"
escape_carriage_return="\\r"
escape_tab="\\t"
escape_unicode_null="\\u0000"
escape_unicode_surrogate="\\uD800\\uDC00"
escape_unicode_surrogate_max="\\uDBFF\\uDFFF"
escape_hex="\\x00"
escape_octal="\\0"

# JSON comments (some JSON parsers support)
comment_single="//"
comment_multi="/**/"

# GLTF specific keywords
gltf_asset="asset"
gltf_scene="scene"
gltf_scenes="scenes"
gltf_nodes="nodes"
gltf_meshes="meshes"
gltf_accessors="accessors"
gltf_bufferViews="bufferViews"
gltf_buffers="buffers"
gltf_materials="materials"
gltf_textures="textures"
gltf_images="images"
gltf_samplers="samplers"
gltf_cameras="cameras"
gltf_animations="animations"
gltf_skins="skins"
gltf_extensions="extensions"
gltf_extras="extras"

# GLTF specific values
gltf_version="\"version\""
gltf_generator="\"generator\""
gltf_minVersion="\"minVersion\""
gltf_copyright="\"copyright\""
gltf_uri="\"uri\""
gltf_byteLength="\"byteLength\""
gltf_target="\"target\""
gltf_ARRAY_BUFFER="34962"
gltf_ELEMENT_ARRAY_BUFFER="34963"
gltf_name="\"name\""
gltf_matrix="\"matrix\""
gltf_rotation="\"rotation\""
gltf_scale="\"scale\""
gltf_translation="\"translation\""
gltf_children="\"children\""
gltf_primitives="\"primitives\""
gltf_attributes="\"attributes\""
gltf_indices="\"indices\""
gltf_mode="\"mode\""
gltf_POINTS="0"
gltf_LINES="1"
gltf_LINE_LOOP="2"
gltf_LINE_STRIP="3"
gltf_TRIANGLES="4"
gltf_TRIANGLE_STRIP="5"
gltf_TRIANGLE_FAN="6"

# Binary GLTF markers
glb_magic="glTF"
binary_gltf_header="data:application/octet-stream;base64,"
