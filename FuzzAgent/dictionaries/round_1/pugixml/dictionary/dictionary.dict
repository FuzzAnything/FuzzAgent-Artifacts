# XML parsing dictionary for pugixml
# Combined from pugixml, expat, and tinyxml2 dictionaries
# Pruned for lean, high-impact fuzzing

# XML Syntax Elements
attr_encoding=" encoding=\"1\""
attr_generic=" a=\"1\""
attr_href=" href=\"1\""
attr_standalone=" standalone=\"no\""
attr_version=" version=\"1\""
attr_xml_base=" xml:base=\"1\""
attr_xml_id=" xml:id=\"1\""
attr_xml_lang=" xml:lang=\"1\""
attr_xml_space=" xml:space=\"1\""
attr_xmlns=" xmlns=\"1\""

# XML Entities
entity_builtin="&lt;"
entity_decimal="&#1;"
entity_external="&a;"
entity_hex="&#x1;"

# XML Keywords
string_any="ANY"
string_cdata="CDATA"
string_empty="EMPTY"
string_entities="ENTITIES"
string_entity="ENTITY"
string_fixed="#FIXED"
string_id="ID"
string_idref="IDREF"
string_idrefs="IDREFS"
string_implied="#IMPLIED"
string_nmtoken="NMTOKEN"
string_nmtokens="NMTOKENS"
string_notation="NOTATION"
string_pcdata="#PCDATA"
string_public="PUBLIC"
string_required="#REQUIRED"
string_system="SYSTEM"

# XML Structural Elements
string_brackets="[]"
string_col_generic=":a"
string_dashes="--"
string_empty_dblquotes="\"\""
string_empty_quotes="''"
string_parentheses="()"
string_percent="%a"
string_ucs4="UCS-4"
string_utf8="UTF-8"
string_utf16="UTF-16"
string_xmlns="xmlns:"

# XML Tags
tag_attlist="<!ATTLIST"
tag_cdata="<![CDATA["
tag_close="</a>"
tag_doctype="<!DOCTYPE"
tag_element="<!ELEMENT"
tag_entity="<!ENTITY"
tag_ignore="<![IGNORE["
tag_include="<![INCLUDE["
tag_notation="<!NOTATION"
tag_open="<a>"
tag_open_close="<a />"
tag_open_exclamation="<!"
tag_open_q="<?"
tag_sq2_close="]]>"
tag_xml_q="<?xml?>"

# Additional encodings from expat
"ISO-8859-1"
"US-ASCII"
"UTF-16BE"
"UTF-16LE"

# Additional namespace declarations from expat
"xmlns:xhtml=\"http://www.w3.org/1999/xhtml\""
"xmlns:xml=\"http://www.w3.org/XML/1998/namespace\""

# XPath Functions (from pugixml fuzz_xpath.dict)
"boolean"
"count"
"contains"
"concat"
"ceiling"
"false"
"floor"
"id"
"last"
"lang"
"local-name"
"name"
"namespace-uri"
"normalize-space"
"not"
"number"
"position"
"round"
"string"
"string-length"
"starts-with"
"substring-before"
"substring-after"
"substring"
"sum"
"translate"
"true"

# XPath Axes
"ancestor"
"ancestor-or-self"
"attribute"
"child"
"descendant"
"descendant-or-self"
"following"
"following-sibling"
"namespace"
"parent"
"preceding"
"preceding-sibling"
"self"
"comment"
"node"
"processing-instruction"
"text"

# XPath Operators and Syntax
"or"
"and"
"div"
"mod"
">"
">="
"<"
"<="
"!"
"!="
"="
"+"
"-"
"*"
"|"
"$"
