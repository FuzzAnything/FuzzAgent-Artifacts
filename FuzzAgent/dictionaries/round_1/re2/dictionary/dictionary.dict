# Lean, high-impact fuzzing dictionary for RE2 (regular expression library)
# Derived from PCRE2 dictionary and RE2 syntax reference, filtered for RE2 compatibility

# Basic escape sequences (RE2 supports these)
escape_A="\\A"
escape_b="\\b"
escape_B="\\B"
escape_d="\\d"
escape_D="\\D"
escape_h="\\h"
escape_H="\\H"
escape_n="\\n"
escape_N="\\N"
escape_s="\\s"
escape_S="\\S"
escape_w="\\w"
escape_W="\\W"
escape_z="\\z"

# Grouping constructs (RE2 supports these)
group_start="("
noncapturing_start="(?:"
atomic_start="(?>"
positive_lookahead_start="(?="
negative_lookahead_start="(?!"
positive_lookbehind_start="(?<="
negative_lookbehind_start="(?<!"
branch_reset_start="(?|"

# POSIX character classes (RE2 supports these)
posix_alnum="[:alnum:]"
posix_alpha="[:alpha:]"
posix_ascii="[:ascii:]"
posix_blank="[:blank:]"
posix_cntrl="[:cntrl:]"
posix_digit="[:digit:]"
posix_graph="[:graph:]"
posix_lower="[:lower:]"
posix_print="[:print:]"
posix_punct="[:punct:]"
posix_space="[:space:]"
posix_upper="[:upper:]"
posix_word="[:word:]"
posix_xdigit="[:xdigit:]"

# Repetition operators
star="*"
plus="+"
question="?"
lazy_star="*?"
lazy_plus="+?"
lazy_question="??"
exact_repeat_0="{0}"
exact_repeat_1="{1}"
exact_repeat_2="{2}"
range_repeat="{1,3}"
range_repeat_lazy="{1,3}?"

# Character classes and sets
char_class_start="["
char_class_end="]"
negated_char_class_start="[^"
any_char="."
alternation="|"
group_end=")"

# Anchors
line_start="^"
line_end="$"
text_start="\\A"
text_end="\\z"

# Named groups (RE2 supports these)
named_group_start="(?P<name>"
named_group_alt_start="(?<name>"

# Flags (RE2 supports these)
flag_i="i"
flag_m="m"
flag_s="s"
flag_U="U"
flag_group_start="(?i)"
flag_group_ms="(?ms)"
flag_clear="(?-i)"

# Unicode character classes (RE2 supports these)
unicode_class_N="\\pN"
unicode_class_Greek="\\p{Greek}"
unicode_class_neg_N="\\PN"
unicode_class_neg_Greek="\\P{Greek}"

# Common patterns
dot_star=".*"
dot_plus=".+"
dot_question=".?"
word_boundary="\\b"
non_word_boundary="\\B"
digit_class="\\d"
non_digit_class="\\D"
whitespace_class="\\s"
non_whitespace_class="\\S"
word_char_class="\\w"
non_word_char_class="\\W"
hex_char_class="\\h"
non_hex_char_class="\\H"

# Empty string assertions
zero_width="(?=)"
