#
# Lean, high-impact fuzzing dictionary for libpng
# Extracted from AFL png.dict and PNG specification
#

# PNG file header (magic bytes)
header_png="\x89PNG\x0d\x0a\x1a\x0a"

# Standard PNG chunk types
section_IHDR="IHDR"
section_PLTE="PLTE"
section_IDAT="IDAT"
section_IEND="IEND"

# Ancillary chunk types (standard)
section_tRNS="tRNS"
section_cHRM="cHRM"
section_gAMA="gAMA"
section_iCCP="iCCP"
section_sBIT="sBIT"
section_sRGB="sRGB"
section_bKGD="bKGD"
section_hIST="hIST"
section_pHYs="pHYs"
section_sPLT="sPLT"
section_tIME="tIME"
section_iTXt="iTXt"
section_tEXt="tEXt"
section_zTXt="zTXt"

# Additional PNG-specific tokens
# Color types
color_type_0="\x00"
color_type_2="\x02"
color_type_3="\x03"
color_type_4="\x04"
color_type_6="\x06"

# Compression method (always 0 in PNG)
compression_method="\x00"

# Filter method (always 0 in standard PNG)
filter_method="\x00"

# Interlace method
interlace_none="\x00"
interlace_adam7="\x01"

# Critical chunk flags
critical_chunk="\x00"
ancillary_chunk="\x20"

# PNG signature bytes
png_sig_1="\x89"
png_sig_2="P"
png_sig_3="N"
png_sig_4="G"
png_sig_5="\x0d"
png_sig_6="\x0a"
png_sig_7="\x1a"
png_sig_8="\x0a"
