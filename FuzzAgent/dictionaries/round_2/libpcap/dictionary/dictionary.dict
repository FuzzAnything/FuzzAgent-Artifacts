# pcap magic numbers from sf-pcap.c
pcap_magic="\xa1\xb2\xc3\xd4"
pcap_kuznetzov_magic="\xa1\xb2\xcd\x34"
pcap_fmesquita_magic="\xa1\xb2\x34\xcd"
pcap_navtel_magic="\xa1\x2b\x3c\x4d"
pcap_nsec_magic="\xa1\xb2\x3c\x4d"

# Common network protocol hex values
eth_type_ip="\x08\x00"
eth_type_ipv6="\x86\xdd"
eth_type_arp="\x08\x06"
eth_type_vlan="\x81\x00"
ip_proto_tcp="\x06"
ip_proto_udp="\x11"
ip_proto_icmp="\x01"
ip_proto_icmpv6="\x3a"

# BPF instruction opcodes
bpf_ld="\x00"
bpf_ldx="\x01"
bpf_st="\x02"
bpf_stx="\x03"
bpf_alu="\x04"
bpf_jmp="\x05"
bpf_ret="\x06"
bpf_misc="\x07"

# Common BPF filter patterns
bpf_ld_abs="\x20\x00\x00\x00"
bpf_ld_ind="\x40\x00\x00\x00"
bpf_ld_len="\x80\x00\x00\x00"
bpf_ld_msh="\xa0\x00\x00\x00"
bpf_ld_imm="\x00\x00\x00\x00"
bpf_ld_mem="\x60\x00\x00\x00"
bpf_ld_abs_ind="\x20\x00\x00\x00"

# pcap file header structure (simplified)
pcap_header_magic="\xa1\xb2\xc3\xd4"
pcap_header_version_major="\x00\x02"
pcap_header_version_minor="\x00\x04"
pcap_header_thiszone="\x00\x00\x00\x00"
pcap_header_sigfigs="\x00\x00\x00\x00"
pcap_header_snaplen="\x00\x00\xff\xff"
pcap_header_network="\x00\x00\x00\x01"

# Packet capture link types
linktype_ethernet="\x00\x00\x00\x01"
linktype_raw="\x00\x00\x00\x65"
linktype_linux_sll="\x00\x00\x00\x71"
linktype_null="\x00\x00\x00\x00"
